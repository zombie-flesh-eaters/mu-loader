{
  "name": "zombie-flesh-eaters/mu-loader",
  "description": "Composer 2 plugin that generates a WordPress MU-plugin autoloader file from configured folders.",
  "type": "composer-plugin",
  "license": "MIT",
  "require": {
    "composer-plugin-api": "^2.0",
    "php": "^7.4 || ^8.0"
  },
  "autoload": {
    "psr-4": {
      "MuLoader\\": "src/"
    }
  },
  "scripts": {
    "test:integration": "bash tests/run-integration.sh"
  },
  "extra": {
    "class": "MuLoader\\Plugin"
  }
}
